# Copy this file to .env and fill in values.

# Server port (default: 3000)
PORT=3000

# ──────────────────────────────────────────────────────
# AUTHENTICATION (pick one — Refresh Token is RECOMMENDED
# for production deployments on Render/Vercel/AWS/etc.)
# ──────────────────────────────────────────────────────

# OPTION 1 (RECOMMENDED — works in datacenters):
# Spotify OAuth Client ID / Secret + Refresh Token.
# These come from a one-time Authorization Code flow you run locally:
#   1. Create an app at https://developer.spotify.com/dashboard
#   2. Set redirect URI to http://localhost:8888/callback
#   3. Authorize with scope "user-read-email user-read-private"
#   4. Exchange the ?code= for access_token + refresh_token
# This endpoint (accounts.spotify.com) is NOT blocked on Render/datacenters.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# OPTION 2 (works from residential IPs, not from datacenters):
# Spotify sp_dc cookie value.
#   1. Log into https://open.spotify.com in your browser
#   2. DevTools → Application → Cookies → copy "sp_dc"
# Note: open.spotify.com/get_access_token is blocked on most datacenter IPs
# (Fastly Varnish 54113), so sp_dc alone will FAIL on Render/Vercel.
SPOTIFY_SP_DC=

# OPTION 3 (Automatic, optional): HTTP(S) proxy for sp_dc exchange.
# Use a residential proxy when you must use sp_dc from a datacenter.
# Example: http://user:pass@proxy.provider.io:31112
HTTPS_PROXY=

# Allowed CORS origin for production (comma-separated). Default: all origins.
ALLOWED_ORIGIN=https://yourdomain.com

NODE_ENV=development
